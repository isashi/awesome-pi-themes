{
  "name": "awesome-pi-themes",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "A curated collection of 25 original dark themes for Pi Coding Agent with a live web preview",
  "homepage": "https://isashi.github.io/awesome-pi-themes/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isashi/awesome-pi-themes.git"
  },
  "scripts": {
    "preview": "node preview-themes-web.js",
    "build": "node preview-themes-web.js --build",
    "check": "node --check preview-themes-web.js && node preview-themes-web.js --check-themes && npm test",
    "test": "node --test"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-coding-agent-theme",
    "pi-theme",
    "pi-themes",
    "terminal-theme",
    "terminal-themes",
    "terminal-colors",
    "tui-theme",
    "cli-theme",
    "dark-theme",
    "dark-themes",
    "awesome-pi",
    "github-pages"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/isashi/awesome-pi-themes/issues"
  },
  "files": [
    "themes",
    "test",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "themes": [
      "./themes"
    ],
    "image": "https://raw.githubusercontent.com/isashi/awesome-pi-themes/main/docs/screenshots/starry-night.jpg"
  },
  "author": "isashi",
  "engines": {
    "node": ">=18"
  }
}
